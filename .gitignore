# 파이썬이 실행하면서 자동으로 만드는 캐시
__pycache__/
*.pyc

# buildozer 빌드 결과물 (SDK/NDK 다운로드, 중간 파일, 완성된 APK)
.buildozer/
bin/

# 테스트/도구 캐시 (coverage 측정 결과 포함)
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
ui_smoke_shots/

# 세이브 파일 - 플레이 기록이라 코드와 함께 관리하지 않는다
game/saves/

# 압축 파일 (업로드용으로 만든 zip 등)
*.zip

# Claude Code 로컬 설정 (규칙/스킬은 커밋한다: .claude/rules/, .claude/skills/)
.claude/settings.local.json

# Graft가 `graft init`으로 남기는 폴더 - 커밋하지 않는다 (그래프는 ~/.cache/graft에 있다)
/graft/

# 운영체제가 만드는 파일
Thumbs.db
desktop.ini
.DS_Store

# 작업시간 기록 훅(.claude/hooks/time-log.cjs)의 세션별 기록 - 요약만 이슈 댓글로 남긴다
.claude/time-log/
